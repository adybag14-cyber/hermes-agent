Builds:
  - versionName: 0.13.153
    versionCode: 145390
    commit: REPLACE_WITH_RELEASE_COMMIT_HASH
    subdir: android/app
    sudo:
      - apt-get update
      - apt-get install -y python3-pip
      - sdkmanager "cmake;3.31.6"
    ndk: 29.0.14206865
    gradle:
      - yes
    gradleprops:
      - hermesFdroidSourceBinding=true
    prebuild:
      - python3.13 ../../scripts/android_fdroid_source_binding.py prepare --repo-root
        ../.. --binding-file "${GRADLE_USER_HOME:-$HOME/.gradle}/hermes-android-fdroid-source-binding.properties"
        --version "$$VERSION$$"
      - sed -i -e 's/System.getenv("HERMES_RELEASE_TAG").orEmpty().trim()/"v$$VERSION$$"/'
        build.gradle.kts
      - sed -i -e 's/return if (osName.contains("windows")) "python" else "python3"/return
        if (osName.contains("windows")) "python" else "python3.13"/' build.gradle.kts

